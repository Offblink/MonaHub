<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>MonaHub 资料提交台</display-name>

    <!--
      ============================================================
      Servlet / Filter / Listener 已全部改为全注解注册（实验二任务 3.1）：
      ContextLoaderListener、DispatcherServlet、CharacterEncodingFilter
      由 ServletContainersInitConfig（AbstractAnnotationConfigDispatcherServletInitializer）
      经 Servlet 3.0 SPI 声明，本文件不再重复声明。
      ============================================================
      这里只保留 Servlet 规范仅有的声明式能力（无编程式 API）：
      容器级错误页与会话策略。
    -->

    <!-- 容器级 404/500（直接访问不存在的 URL）转发到 /error 友好页 -->
    <error-page>
        <error-code>404</error-code>
        <location>/error</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error</location>
    </error-page>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>
</web-app>
