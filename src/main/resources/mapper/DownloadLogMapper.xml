<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monahub.mapper.DownloadLogMapper">

    <insert id="insert" parameterType="com.monahub.entity.DownloadLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO download_log (file_id, downloader_id, download_time, ip)
        VALUES (#{fileId}, #{downloaderId}, #{downloadTime}, #{ip})
    </insert>

</mapper>
