<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans  http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc    http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!--
      ============================================================
      子容器（表现层）—— DispatcherServlet 启动，映射 "/"
      ============================================================
      【分工】子容器只扫 controller / config / interceptor / aspect / exception，
              父容器只扫 service / mapper —— 两边不重叠，避免 Bean 重复注册。

      【拦截器】注册方式必须走 WebMvcConfigurer#addInterceptors（任务书 F1），
              见 com.monahub.config.WebConfig；本文件只负责把 Bean 扫进来。
    -->

    <!--
      注意：这里不再写 <mvc:annotation-driven/>。
      XML 版 annotation-driven 不会收集 WebMvcConfigurer Bean，
      而任务书要求拦截器必须用 WebMvcConfigurer#addInterceptors 注册 ——
      所以改由 com.monahub.config.WebConfig 上的 @EnableWebMvc 驱动 MVC 装配
      （它内部就是 DelegatingWebMvcConfiguration，会收集本容器里的所有 WebMvcConfigurer）。
      注意不要同时保留 mvc:annotation-driven，否则 Mapping/Adapter 会重复注册。
    -->

    <context:component-scan base-package="com.monahub.controller,com.monahub.config,
                                        com.monahub.interceptor,com.monahub.exception"/>

    <!-- 静态资源：/static/** 由容器直接读 webapp/static，并已在拦截器放行清单内 -->
    <mvc:resources mapping="/static/**" location="/static/"/>

    <!-- 上传接口的 JSON 响应（XHR 形态）用它序列化逐文件结果 -->
    <bean id="objectMapper" class="com.fasterxml.jackson.databind.ObjectMapper"/>

    <!-- JSP 视图：Controller 返回 "files" → /WEB-INF/views/files.jsp（WEB-INF 不可直接访问） -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!--
      文件上传解析器：Bean 名必须是 multipartResolver。
      · defaultEncoding=UTF-8  → 中文原始文件名不乱码
      · maxUploadSizePerFile   → 单文件 10MB（与 Service 二次校验一致）
      · maxUploadSize          → 一次请求总上限 50MB（多文件批量）
      · resolveLazily=true     → 超限异常在参数解析阶段抛出，可被 @ControllerAdvice 友好处理
    -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="defaultEncoding" value="UTF-8"/>
        <property name="maxUploadSizePerFile" value="10485760"/>
        <property name="maxUploadSize" value="52428800"/>
        <property name="resolveLazily" value="true"/>
    </bean>

</beans>
